@model IEnumerable<Petshop_frontend.Models.Blog>
@{
    ViewData["Title"] = "Quản lý bài viết";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold">Danh sách tin tức</h3>
    <a asp-action="Create" class="btn btn-primary rounded-pill px-4">
        <i class="fas fa-plus me-1"></i> Viết bài mới
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">Ảnh</th>
                    <th>Tiêu đề</th>
                    <th>Ngày đăng</th>
                    <th>Trạng thái</th>
                    <th class="text-end pe-4">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <img src="@item.ImageUrl" class="rounded-3" style="width: 60px; height: 45px; object-fit: cover;" onerror="this.src='/images/default-blog.jpg'">
                        </td>
                        <td class="fw-bold text-dark">@item.Title</td>
                        <td class="small text-muted">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            @if (item.IsPublished)
                            {
                                <span class="badge bg-success-soft text-success rounded-pill px-3">Hiển thị</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-soft text-secondary rounded-pill px-3">Nháp</span>
                            }
                        </td>
                        <td class="text-end pe-4">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light border rounded-pill px-3 me-1">Sửa</a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Xóa bài này hả ông giáo?')">
                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>