@model Petshop_frontend.Models.Order
@{
    ViewData["Title"] = "Thanh toán đơn hàng";
    
    // Cấu hình thông tin ngân hàng thật của ông giáo dựa theo ảnh mẫu
    string bankCode = "MBBank"; 
    string bankAccount = "0336177161"; 
    string accountName = "NGUYEN VAN KHAI"; 
    
    string totalAmount = (Model.TotalAmount.Value).ToString("0"); // Ép kiểu số tiền về dạng chuỗi không dấu chấm
    string memo = "DH" + Model.Id; // Ví dụ: DH538 giống trong ảnh
    
    // Link API sinh mã VietQR chuẩn SePay
    string qrUrl = $"https://img.vietqr.io/image/{bankCode}-{bankAccount}-compact2.png?amount={totalAmount}&addInfo={memo}&accountName={Uri.EscapeDataString(accountName)}";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-xl-10">
            
            <div class="payment-box rounded-4 text-white overflow-hidden shadow-lg mb-4">
                <div class="payment-header text-center py-3 border-bottom border-secondary">
                    <h5 class="mb-0 fw-bold text-uppercase tracking-wide">Thanh toán qua chuyển khoản ngân hàng</h5>
                </div>
                
                <div class="card-body p-4 p-md-5">
                    <div class="row g-4 align-items-center">
                        
                        <div class="col-md-6 text-center border-end border-secondary-subtle">
                            <h6 class="fw-bold mb-3 opacity-90">Cách 1: Mở app ngân hàng/ Ví và quét mã QR</h6>
                            <div class="qr-wrapper bg-white p-3 rounded-4 d-inline-block position-relative border mb-3">
                                <img src="@qrUrl" alt="Mã VietQR SePay" class="img-fluid" style="max-width: 260px;" />
                                <div class="qr-scanner-line"></div>
                            </div>
                            <div>
                                <a href="@qrUrl" download="VietQR-@memo" class="btn btn-sm btn-primary rounded-pill px-4">
                                    <i class="fas fa-download me-1"></i> Tải ảnh QR
                                </a>
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                            <h6 class="fw-bold mb-3 opacity-90 text-center text-md-start">Cách 2: Chuyển khoản <span class="text-warning">thủ công</span> theo thông tin</h6>
                            
                            <div class="d-flex flex-column gap-2 info-table">
                                <div class="d-flex justify-content-between align-items-center py-2 border-bottom border-secondary">
                                    <span class="opacity-75 small">Ngân hàng</span>
                                    <span class="fw-bold text-info">@bankCode</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center py-2 border-bottom border-secondary">
                                    <span class="opacity-75 small">Thụ hưởng</span>
                                    <span class="fw-bold">@accountName</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center py-2 border-bottom border-secondary">
                                    <span class="opacity-75 small">Số tài khoản</span>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fw-bold text-warning fs-5" id="txtAccount">@bankAccount</span>
                                        <button class="btn btn-xs btn-outline-light p-1 py-0 rounded" onclick="copyText('txtAccount')">
                                            <i class="far fa-copy" style="font-size: 0.75rem;"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="d-flex justify-content-between align-items-center py-2 border-bottom border-secondary">
                                    <span class="opacity-75 small">Số tiền</span>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fw-black text-danger fs-5" id="txtAmount">@(Model.TotalAmount.Value.ToString("N0")) đ</span>
                                        <button class="btn btn-xs btn-outline-light p-1 py-0 rounded" onclick="copyTextValue('txtAmount', '@totalAmount')">
                                            <i class="far fa-copy" style="font-size: 0.75rem;"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="d-flex justify-content-between align-items-center py-2 border-bottom border-secondary">
                                    <span class="opacity-75 small">Nội dung CK</span>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-danger fs-6 px-3" id="txtMemo">@memo</span>
                                        <button class="btn btn-xs btn-outline-light p-1 py-0 rounded" onclick="copyText('txtMemo')">
                                            <i class="far fa-copy" style="font-size: 0.75rem;"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="alert alert-warning-custom rounded-3 p-3 mt-4">
                                <i class="fas fa-exclamation-triangle text-warning me-2"></i>
                                <strong>Lưu ý:</strong> Vui lòng giữ nguyên nội dung chuyển khoản <span class="text-danger fw-bold">@memo</span> để xác nhận thanh toán tự động.
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="payment-footer bg-dark-subtle text-center py-3 border-top border-secondary d-flex align-items-center justify-content-center gap-2">
                    <div class="spinner-border spinner-border-sm text-warning" role="status"></div>
                    <span class="small fw-bold opacity-90" id="payment-status">Trạng thái: Chờ thanh toán...</span>
                </div>
            </div>

        </div>
    </div>
</div>

@section Styles {
    <style>
        /* CSS tạo khối màu Navy đậm chất SePay giống ảnh của ông giáo */
        .payment-box {
            background-color: #0f172a; /* Màu xanh đen thẫm cực sang */
            border: 1px solid #1e293b;
        }
        .payment-header {
            background-color: #1e293b;
        }
        .info-table span {
            font-size: 0.95rem;
        }
        .alert-warning-custom {
            background-color: #1a1610;
            border: 1px solid #453214;
            color: #fbbf24;
            font-size: 0.88rem;
            line-height: 1.5;
        }
        /* Hiệu ứng tia laze quét mã QR */
        .qr-scanner-line {
            position: absolute; left: 0; right: 0; height: 2px;
            background: linear-gradient(to right, rgba(220,53,69,0), rgba(220,53,69,1), rgba(220,53,69,0));
            animation: scan 2.5s linear infinite; top: 0;
        }
        @Html.Raw("@keyframes scan { 0% { top: 0%; } 50% { top: 100%; } 100% { top: 0%; } }")
        .tracking-wide {
            letter-spacing: 0.5px;
        }
    </style>
}

@section Scripts {
    <script>
        // 1. Tự động kiểm tra trạng thái thanh toán sau mỗi 3 giây
        $(document).ready(function () {
            let checkPaymentInterval = setInterval(function () {
                $.ajax({
                    url: '/Order/CheckStatus/@Model.Id',
                    type: 'GET',
                    success: function (res) {
                        if (res.isPaid) {
                            clearInterval(checkPaymentInterval);
                            $('#payment-status').html('<span class="text-success fw-bold"><i class="fas fa-check-circle me-1"></i> Trạng thái: Đã nhận tiền thành công! Đang xử lý...</span>');
                            setTimeout(function () {
                                window.location.href = '/Order/Success/@Model.Id';
                            }, 2000);
                        }
                    }
                });
            }, 3000);
        });

        // 2. Hàm xử lý Copy Text nhanh cho khách hàng đỡ gõ tay
        function copyText(elementId) {
            let text = document.getElementById(elementId).innerText;
            navigator.clipboard.writeText(text);
            alert("Đã sao chép: " + text);
        }
        
        function copyTextValue(elementId, value) {
            navigator.clipboard.writeText(value);
            alert("Đã sao chép số tiền: " + parseInt(value).toLocaleString() + "đ");
        }
    </script>
}