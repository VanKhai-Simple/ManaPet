@model Petshop_frontend.Models.Blog
@{
    ViewData["Title"] = Model.Title;
    var relatedBlogs = ViewBag.RelatedBlogs as IEnumerable<Petshop_frontend.Models.Blog>;
}

@section Styles {
    <style>
        .post-content-area img {
            max-width: 100% !important;
            height: auto !important;
            border-radius: 16px;
            margin: 15px 0;
        }

        .post-content-area p {
            line-height: 1.8;
            color: #333;
            margin-bottom: 1.2rem;
            font-size: 1.05rem;
        }

        .sidebar-post-card {
            transition: opacity 0.2s;
        }

            .sidebar-post-card:hover {
                opacity: 0.85;
            }
    </style>
}

<div class="container my-5 pt-3">
    <div class="row g-5">

        <div class="col-12 col-lg-8">
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Trang chủ</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">Tin tức</a></li>
                    <li class="breadcrumb-item active text-dark fw-bold text-truncate" aria-current="page" style="max-width: 250px;">@Model.Title</li>
                </ol>
            </nav>

            <h1 class="fw-black mb-3 text-dark" style="font-size: 2rem; line-height: 1.3;">@Model.Title</h1>

            <div class="d-flex align-items-center gap-4 text-muted small border-bottom pb-3 mb-4">
                <span><i class="far fa-calendar-alt me-1 text-primary"></i> Đăng ngày: @Model.CreatedAt.ToString("dd/MM/yyyy")</span>
            </div>

            @if (!string.IsNullOrEmpty(Model.ShortDescription))
            {
                <div class="p-3 bg-light border-start border-4 rounded-end mb-4 fw-semibold text-secondary" style="border-color: var(--primary-color, #0d6efd) !important;">
                    @Model.ShortDescription
                </div>
            }

            <div class="post-content-area">
                @Html.Raw(Model.Content)
            </div>

            <div class="border-top pt-4 mt-5">
                <a asp-action="Index" class="btn btn-outline-dark rounded-pill fw-bold">
                    <i class="fas fa-chevron-left me-2"></i> Quay lại danh sách tin
                </a>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="position-sticky" style="top: 25px;">
                <h5 class="fw-bold mb-3 pb-2 border-bottom"><i class="fas fa-fire me-2 text-danger"></i>Bài viết mới nhất</h5>

                @if (relatedBlogs != null && relatedBlogs.Any())
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var rb in relatedBlogs)
                        {
                            <a asp-action="Details" asp-route-id="@rb.Id" class="d-flex align-items-center gap-3 text-decoration-none sidebar-post-card border-bottom pb-3">
                                <img src="@(string.IsNullOrEmpty(rb.ImageUrl) ? "/images/default-blog.jpg" : rb.ImageUrl)" alt="@rb.Title" class="rounded-3 object-fit-cover" style="width: 75px; height: 75px; min-width: 75px;">
                                <div class="overflow-hidden">
                                    <h6 class="text-dark fw-bold text-truncate mb-1" style="font-size: 0.88rem;" title="@rb.Title">@rb.Title</h6>
                                    <span class="text-muted small" style="font-size: 0.75rem;"><i class="far fa-calendar-alt me-1"></i> @rb.CreatedAt.ToString("dd/MM/yyyy")</span>
                                </div>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted small">Không có bài viết liên quan khác.</p>
                }
            </div>
        </div>

    </div>
</div>