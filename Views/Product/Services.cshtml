<style>
    /* CSS Tối ưu hóa giao diện theo ảnh mẫu */
    .intro-section h2 {
        color: #2c3e50;
        font-size: 22px;
        letter-spacing: 0.5px;
    }

    /* Đổ ảnh nền thiên nhiên mờ phía sau giống bức ảnh mẫu của ông giáo */
    .services-banner-bg {
        background: linear-gradient(rgba(44, 62, 80, 0.5), rgba(44, 62, 80, 0.6)), url('https://images.unsplash.com/photo-1548199973-03cce0bbc87b?q=80&w=1469&auto=format&fit=crop') center/cover no-repeat;
    }

    .content-block {
        transition: transform 0.3s ease;
        border-top: 5px solid;
    }

    .border-top-danger {
        border-top-color: #d9534f !important;
    }

    .border-top-success {
        border-top-color: #5cb85c !important;
    }

    .content-block:hover {
        transform: scale(1.02);
    }

    .block-title {
        font-size: 16px;
        letter-spacing: 0.5px;
    }

    .message-highlight h5 {
        color: #2c3e50;
        font-weight: bold;
        font-size: 15px;
    }

    .list-check li {
        margin-bottom: 10px;
        font-size: 14px;
        line-height: 1.5;
    }

    .text-shadow {
        text-shadow: 1px 1px 4px rgba(0,0,0,0.8);
    }

    /* Định hình nút bấm liên hệ */
    .btn-cta {
        padding: 12px 30px;
        font-size: 15px;
        text-transform: uppercase;
        border-radius: 50px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.3);
        transition: 0.3s;
    }

        .btn-cta:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(0,0,0,0.4);
            color: #fff !important;
        }

    /* Hiệu ứng nhấp nháy cho nút Hotline tạo sự chú ý */
    .animation-pulse {
        animation: pulse-effect 2s infinite;
    }

    @@keyframes pulse-effect {
        0% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.05);
        }

        100% {
            transform: scale(1);
        }
    }
</style>