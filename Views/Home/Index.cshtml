@model Petshop_frontend.Controllers.HomeController.HomeViewModel
@{
    ViewData["Title"] = "Trang Chủ";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home-premium.css" />
    <style>
        .custom-blog-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .custom-blog-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important;
            }

        .blog-img {
            transition: transform 0.5s ease;
        }

        .custom-blog-card:hover .blog-img {
            transform: scale(1.08);
        }

        .blog-badge {
            background-color: var(--c-primary, #0d6efd) !important;
            font-size: 0.75rem;
        }

        .blog-title-clamp {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            height: 3rem;
        }

        .blog-desc-clamp {
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .read-more-link:hover .fa-angle-double-right {
            transform: translateX(3px);
        }

        .transition-all {
            transition: all 0.2s ease;
        }
    </style>
}

<div class="homepage-wrapper">
    <section class="hero-section position-relative py-5 overflow-hidden" style="background-color: var(--c-bg);">
        <div class="container pe-lg-5 position-relative" style="z-index: 2;">
            <div class="row align-items-center mb-5 pb-xl-5">
                <div class="col-lg-6 mb-5 mb-lg-0 text-center text-lg-start pe-lg-5">
                    <span class="badge bg-white text-primary rounded-pill px-4 py-2 mt-3 mb-4 d-inline-flex align-items-center shadow-sm" style="font-weight: 700; font-size: 14px;">
                        <i class="fas fa-paw me-2 text-warning"></i> Chăm sóc tận tâm
                    </span>
                    <h1 class="display-4 fw-black mb-4 lh-base" style="color: var(--c-text);">
                        Người bạn nhỏ đáng yêu cho ngôi nhà của bạn
                    </h1>
                    <p class="lead mb-5 fs-5" style="color: var(--c-text-muted);">
                        Khám phá chó, mèo khỏe mạnh cùng hàng trăm phụ kiện chất lượng cho thú cưng. Chúng tôi mang đến cho bạn niềm vui bất tận trên từng dấu chân nhỏ.
                    </p>
                    <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center justify-content-lg-start mb-5">
                        <a asp-controller="Product" asp-action="Index" class="btn btn-primary d-inline-flex align-items-center justify-content-center py-3 px-5 rounded-pill shadow-hover" style="background-color: var(--c-primary); border-color: var(--c-primary); font-weight: 700; font-size: 1.1rem; transition: 0.3s;">
                            Xem thú cưng ngay <i class="fas fa-arrow-right ms-2"></i>
                        </a>
                        <a asp-controller="Product" asp-action="Accessories" class="btn btn-outline-primary d-inline-flex align-items-center justify-content-center py-3 px-5 rounded-pill hero-btn-outline" style="border: 2px solid var(--c-primary); color: var(--c-primary); font-weight: 700; font-size: 1.1rem; background: white; transition: 0.3s;">
                            Mua phụ kiện <i class="fas fa-shopping-bag ms-2"></i>
                        </a>
                    </div>

                    <div class="row g-3 text-start features-badges mt-4 mb-5 pb-4">
                        <div class="col-6 col-md-3 d-flex flex-column align-items-center align-items-lg-start">
                            <div class="feature-icon-wrapper rounded-circle d-flex align-items-center justify-content-center mb-2 shadow-sm" style="width: 50px; height: 50px; background: white;">
                                <i class="fas fa-syringe fs-4" style="color: var(--c-secondary);"></i>
                            </div>
                            <span class="small fw-bold text-center text-lg-start">Tiêm phòng<br>đầy đủ</span>
                        </div>
                        <div class="col-6 col-md-3 d-flex flex-column align-items-center align-items-lg-start">
                            <div class="feature-icon-wrapper rounded-circle d-flex align-items-center justify-content-center mb-2 shadow-sm" style="width: 50px; height: 50px; background: white;">
                                <i class="fas fa-user-md fs-4" style="color: var(--c-secondary);"></i>
                            </div>
                            <span class="small fw-bold text-center text-lg-start">Tư vấn<br>chăm sóc 1:1</span>
                        </div>
                        <div class="col-6 col-md-3 d-flex flex-column align-items-center align-items-lg-start">
                            <div class="feature-icon-wrapper rounded-circle d-flex align-items-center justify-content-center mb-2 shadow-sm" style="width: 50px; height: 50px; background: white;">
                                <i class="fas fa-truck fs-4" style="color: var(--c-secondary);"></i>
                            </div>
                            <span class="small fw-bold text-center text-lg-start">Giao hàng<br>toàn quốc</span>
                        </div>
                        <div class="col-6 col-md-3 d-flex flex-column align-items-center align-items-lg-start">
                            <div class="feature-icon-wrapper rounded-circle d-flex align-items-center justify-content-center mb-2 shadow-sm" style="width: 50px; height: 50px; background: white;">
                                <i class="fas fa-exchange-alt fs-4" style="color: var(--c-secondary);"></i>
                            </div>
                            <span class="small fw-bold text-center text-lg-start">Đổi trả<br>dễ dàng</span>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6 position-relative hero-image-col mt-5 mt-lg-0 pb-5">
                    <i class="fas fa-paw position-absolute text-white opacity-50" style="font-size: 5rem; top: -20px; right: 20px; transform: rotate(15deg);"></i>
                    <i class="fas fa-paw position-absolute text-white opacity-50" style="font-size: 3rem; bottom: 50px; left: -10px; transform: rotate(-25deg);"></i>

                    <div class="hero-image-wrapper mx-auto ms-lg-auto position-relative z-2">
                        <div class="blob-shape bg-warning bg-opacity-25 position-absolute top-50 start-50 translate-middle" style="width: 120%; height: 120%; border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%; z-index: -1;"></div>
                        <img src="~/Images/hero-banner.png" alt="Happy pets" class="img-fluid hero-main-img border-radius-lg drop-shadow-2xl object-fit-cover shadow-lg" style="border-radius: var(--border-radius-lg); width: 100%; aspect-ratio: 4/3;">

                        <div class="floating-card position-absolute bg-white p-3 rounded-4 shadow-medium bottom-0 start-0 translate-middle-y ms-n4 mb-n5 d-none d-md-flex align-items-center slide-up-anim" style="z-index: 2;">
                            <img src="https://images.unsplash.com/photo-1583337130417-3346a1be7dee?auto=format&fit=crop&w=150&q=80" class="rounded-circle object-fit-cover me-3" style="width: 60px; height: 60px;" alt="Đồ chơi">
                            <div>
                                <h6 class="mb-1 fw-bold">Combo Bát + Bóng</h6>
                                <span class="text-primary fw-bold">150.000₫</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <svg class="position-absolute bottom-0 start-0 w-100" viewBox="0 0 1440 100" fill="none" xmlns="http://www.w3.org/2000/svg" style="z-index: 0;">
            <path d="M0 60C240 10 480 10 720 30C960 50 1200 40 1440 10V100H0V60Z" fill="var(--c-bg-light)" />
        </svg>
    </section>

    <section class="category-section py-5 z-2 position-relative" style="margin-top: -60px;">
        <div class="container">
            <div class="row g-4 justify-content-center">
                <div class="col-6 col-lg-3">
                    <a asp-controller="Product" asp-action="ChoCanh" class="text-decoration-none">
                        <div class="cat-card bg-white p-4 rounded-4 shadow-soft text-center h-100 border transition-all hover-lift">
                            <div class="cat-img-wrap overflow-hidden rounded-circle mx-auto mb-3" style="width: 120px; height: 120px; border: 4px solid var(--c-bg);">
                                <img src="https://images.unsplash.com/photo-1543466835-00a7907e9de1?auto=format&fit=crop&w=300&q=80" alt="Chó cảnh" class="w-100 h-100 object-fit-cover transition-transform">
                            </div>
                            <h4 class="fw-bold mb-2 text-dark">Chó Cảnh</h4>
                            <p class="text-muted small mb-3">Các bé cún ngoan ngoãn, đã tiêm phòng đầy đủ.</p>
                            <span class="btn btn-sm btn-outline-primary rounded-pill px-4" style="color: var(--c-primary); border-color: var(--c-primary);">Xem thêm</span>
                        </div>
                    </a>
                </div>
                <div class="col-6 col-lg-3">
                    <a asp-controller="Product" asp-action="MeoCanh" class="text-decoration-none">
                        <div class="cat-card bg-white p-4 rounded-4 shadow-soft text-center h-100 border transition-all hover-lift">
                            <div class="cat-img-wrap overflow-hidden rounded-circle mx-auto mb-3" style="width: 120px; height: 120px; border: 4px solid var(--c-bg);">
                                <img src="https://images.unsplash.com/photo-1514888286974-6c03e2ca1dba?auto=format&fit=crop&w=300&q=80" alt="Mèo cảnh" class="w-100 h-100 object-fit-cover transition-transform">
                            </div>
                            <h4 class="fw-bold mb-2 text-dark">Mèo Cảnh</h4>
                            <p class="text-muted small mb-3">Những thiên thần nhỏ lanh lợi, quấn chủ.</p>
                            <span class="btn btn-sm btn-outline-primary rounded-pill px-4" style="color: var(--c-primary); border-color: var(--c-primary);">Xem thêm</span>
                        </div>
                    </a>
                </div>
                <div class="col-6 col-lg-3">
                    <a asp-controller="Product" asp-action="Accessories" class="text-decoration-none">
                        <div class="cat-card bg-white p-4 rounded-4 shadow-soft text-center h-100 border transition-all hover-lift">
                            <div class="cat-img-wrap overflow-hidden rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center bg-light" style="width: 120px; height: 120px; border: 4px solid var(--c-bg);">
                                <i class="fas fa-bone fs-1" style="color: var(--c-secondary);"></i>
                            </div>
                            <h4 class="fw-bold mb-2 text-dark">Phụ Kiện</h4>
                            <p class="text-muted small mb-3">Nhà, nệm, đồ chơi và thức ăn dinh dưỡng.</p>
                            <span class="btn btn-sm btn-outline-primary rounded-pill px-4" style="color: var(--c-primary); border-color: var(--c-primary);">Xem thêm</span>
                        </div>
                    </a>
                </div>
                <div class="col-6 col-lg-3">
                    <a asp-controller="Services" asp-action="Index" class="text-decoration-none">
                        <div class="cat-card bg-white p-4 rounded-4 shadow-soft text-center h-100 border transition-all hover-lift">
                            <div class="cat-img-wrap overflow-hidden rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center bg-light" style="width: 120px; height: 120px; border: 4px solid var(--c-bg);">
                                <i class="fas fa-bath fs-1" style="color: var(--c-secondary);"></i>
                            </div>
                            <h4 class="fw-bold mb-2 text-dark">Dịch Vụ Spa</h4>
                            <p class="text-muted small mb-3">Tắm rửa, cắt tỉa lông chuyên nghiệp chất lượng.</p>
                            <span class="btn btn-sm btn-outline-primary rounded-pill px-4" style="color: var(--c-primary); border-color: var(--c-primary);">Xem thêm</span>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <section class="featured-pets-section py-5 position-relative">
        <div class="container">
            <div class="d-flex justify-content-between align-items-end mb-4">
                <div>
                    <span class="text-primary fw-bold d-block mb-1"><i class="fas fa-star me-2"></i>Các bé mới về</span>
                    <h2 class="display-6 fw-black mb-0">Thú Cưng Nổi Bật</h2>
                </div>
                <a asp-controller="Product" asp-action="Index" class="text-primary fw-bold text-decoration-none">Xem tất cả <i class="fas fa-chevron-right ms-1"></i></a>
            </div>

            <div class="row g-4">
                @if (Model?.FeaturedPets != null && Model.FeaturedPets.Any())
                {
                    @foreach (var pet in Model.FeaturedPets)
                    {
                        <div class="col-12 col-md-6 col-xl-4">
                            <div class="pet-card card border-0 bg-white rounded-4 shadow-sm overflow-hidden h-100 hover-lift">
                                <div class="position-relative overflow-hidden" style="aspect-ratio: 4/3;">
                                    <img src="@(string.IsNullOrEmpty(pet.ImageUrl) ? "/images/default-pet.jpg" : pet.ImageUrl)" alt="@pet.Name" class="w-100 h-100 object-fit-cover transition-transform pet-img">
                                    <div class="position-absolute top-0 start-0 m-3 px-3 py-1 bg-white rounded-pill shadow-sm fw-bold fs-7 d-flex align-items-center text-dark">
                                        @if (pet.Gender == false)
                                        {
                                            <i class="fas fa-venus text-danger me-2"></i>
                                            <span>Cái</span>
                                        }
                                        else
                                        {
                                            <i class="fas fa-mars text-info me-2"></i>
                                            <span>Đực</span>
                                        }
                                    </div>
                                </div>
                                <div class="card-body p-4">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h4 class="card-title fw-bold mb-0 text-truncate" style="max-width: 65%;">@pet.Name</h4>
                                        <h4 class="text-primary fw-bold mb-0">@pet.Price.ToString("N0")₫</h4>
                                    </div>
                                    <p class="text-muted mb-3"><i class="fas fa-tag me-2"></i>@(string.IsNullOrEmpty(pet.Breed) ? "Đang cập nhật" : pet.Breed)</p>

                                    <div class="row g-2 mb-4 text-center">
                                        <div class="col-4">
                                            <div class="bg-light rounded p-2">
                                                <div class="small text-muted mb-1">Tuổi</div>
                                                <div class="fw-bold fs-7 text-truncate">@(pet.AgeMonths.HasValue? pet.AgeMonths + " tháng" : "Chưa rõ")</div>
                                            </div>
                                        </div>
                                        <div class="col-8">
                                            <div class="bg-light rounded p-2">
                                                <div class="small text-muted mb-1">Sức khỏe</div>
                                                <div class="fw-bold fs-7 text-success text-truncate"><i class="fas fa-check-circle me-1"></i>@(string.IsNullOrEmpty(pet.HealthStatus) ? "Tốt" : pet.HealthStatus)</div>
                                            </div>
                                        </div>
                                    </div>
                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@pet.Id" class="btn btn-outline-primary w-100 rounded-pill py-2 fw-bold" style="border-color: var(--c-primary); color: var(--c-primary);">Xem chi tiết</a>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center py-4">
                        <p class="text-muted">Hiện tại chưa có thú cưng nổi bật nào.</p>
                    </div>
                }
            </div>
        </div>
    </section>

    <section class="promo-banner py-5">
        <div class="container my-4">
            <div class="row bg-warning bg-opacity-25 rounded-5 overflow-hidden align-items-center position-relative shadow-sm" style="background-color: var(--c-bg) !important;">
                <div class="col-lg-7 p-5 z-1">
                    <span class="badge bg-danger rounded-pill px-3 py-2 mb-3 fw-bold fs-6 shadow-sm"><i class="fas fa-fire me-2"></i>ƯU ĐÃI THÁNG NÀY</span>
                    <h2 class="display-5 fw-black mb-3">Tặng 100% Voucher Phụ Kiện <span class="text-primary">Khi Mua Thú Cưng</span></h2>
                    <p class="fs-5 text-muted mb-4">Combo quà tặng "Tân binh" trị giá 500k (Bát ăn, đai dắt, đồ chơi) dành riêng cho hóa đơn rước bé yêu về nhà tuần này!</p>
                    <a asp-controller="Product" asp-action="Index" class="btn btn-primary rounded-pill px-5 py-3 fw-bold fs-5 shadow-hover" style="background-color: var(--c-primary); border:none;">Nhận Ngay <i class="fas fa-arrow-right ms-2"></i></a>
                </div>
                <div class="col-lg-5 p-0 d-none d-lg-block z-1">
                    <img src="https://images.unsplash.com/photo-1541781774459-bb2af2f05b55?auto=format&fit=crop&w=800&q=80" alt="Promo image" class="w-100 h-100 object-fit-cover drop-shadow-2xl" style="mask-image: linear-gradient(to right, transparent, black 15%); -webkit-mask-image: linear-gradient(to right, transparent, black 15%); min-height: 400px;">
                </div>
            </div>
        </div>
    </section>

    <section class="featured-products-section py-5 bg-white">
        <div class="container">
            <div class="text-center mb-5">
                <span class="text-primary fw-bold d-block mb-1">Best Sellers</span>
                <h2 class="display-6 fw-black">Phụ Kiện Bán Chạy</h2>
            </div>

            <div class="row g-4">
                @if (Model?.BestSellingProducts != null && Model.BestSellingProducts.Any())
                {
                    @foreach (var product in Model.BestSellingProducts)
                    {
                        <div class="col-6 col-md-3">
                            <div class="product-card card border bg-white rounded-4 shadow-sm h-100 hover-lift text-center position-relative">
                                @if (product.DiscountPercent > 0)
                                {
                                    <span class="position-absolute top-0 end-0 bg-danger text-white px-2 py-1 m-2 rounded fw-bold fs-7 z-2">-@product.DiscountPercent%</span>
                                }
                                <div class="p-3 position-relative overflow-hidden">
                                    <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "/images/default-product.jpg" : product.ImageUrl)" class="w-100 object-fit-cover rounded-3 product-img transition-transform" style="aspect-ratio: 1/1;" alt="@product.Name">
                                    <div class="cart-overlay position-absolute w-100 h-100 top-0 start-0 d-flex justify-content-center align-items-center opacity-0 transition-all bg-dark bg-opacity-25 rounded-3">
                                        <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                            <input type="hidden" name="productId" value="@product.Id" />
                                            <button type="submit" class="btn btn-light rounded-circle shadow-medium" style="width: 50px; height: 50px;">
                                                <i class="fas fa-cart-plus fs-5 text-primary"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                                <div class="card-body pt-0 pb-4 px-3">
                                    <h6 class="card-title fw-bold text-truncate" title="@product.Name" style="margin-top: 10px;">@product.Name</h6>
                                    <h5 class="text-primary fw-bold mb-0">@product.Price.ToString("N0")₫</h5>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center py-4">
                        <p class="text-muted">Chưa có sản phẩm phụ kiện bán chạy nào.</p>
                    </div>
                }
            </div>

            <div class="text-center mt-4">
                <a asp-controller="Product" asp-action="Accessories" class="btn btn-outline-dark rounded-pill px-4 fw-bold shadow-sm">Xem Toàn Bộ Cửa Hàng <i class="fas fa-shopping-bag ms-2"></i></a>
            </div>
        </div>
    </section>

    <section class="blog-section py-5" style="background-color: var(--c-bg-light);">
        <div class="container my-4">
            <div class="text-center mb-5">
                <span class="text-primary fw-bold d-block mb-1">Kiến thức & Kinh nghiệm</span>
                <h2 class="display-6 fw-black">Tin Tức Thú Cưng</h2>
            </div>

            <div class="row g-4 justify-content-center">
                @if (Model?.LatestBlogs != null && Model.LatestBlogs.Any())
                {
                    @foreach (var blog in Model.LatestBlogs)
                    {
                        <div class="col-md-4">
                            <div class="card border-0 bg-white rounded-4 shadow-sm overflow-hidden h-100 custom-blog-card">
                                <div class="overflow-hidden" style="aspect-ratio: 16/10;">
                                    <img src="@(string.IsNullOrEmpty(blog.ImageUrl) ? "/images/default-blog.jpg" : blog.ImageUrl)"
                                         class="w-100 h-100 object-fit-cover blog-img"
                                         alt="@blog.Title">
                                </div>

                                <div class="card-body p-4 position-relative d-flex flex-column">
                                    <span class="position-absolute px-3 py-1 text-white rounded-pill fw-bold fs-7 shadow-sm blog-badge" style="top: -15px; left: 1rem;">
                                        Tin tức
                                    </span>

                                    <h5 class="card-title fw-bold mt-2 lh-base blog-title-clamp">
                                        <a asp-controller="Blog" asp-action="Details" asp-route-id="@blog.Id" class="text-decoration-none text-dark hover-text-primary transition-all">
                                            @blog.Title
                                        </a>
                                    </h5>

                                    <p class="card-text text-muted small mt-2 blog-desc-clamp flex-grow-1">
                                        @blog.ShortDescription
                                    </p>
                                </div>

                                <div class="card-footer bg-white border-0 px-4 pb-4 pt-1 d-flex justify-content-between align-items-center">
                                    <span class="small text-muted fw-bold">
                                        <i class="far fa-calendar-alt me-1"></i> @blog.CreatedAt.ToString("dd/MM/yyyy")
                                    </span>
                                    <a asp-controller="Blog" asp-action="Details" asp-route-id="@blog.Id" class="text-primary text-decoration-none fw-bold fst-italic read-more-link">
                                        Đọc tiếp <i class="fas fa-angle-double-right ms-1 transition-all"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center py-4">
                        <p class="text-muted">Chưa có bài viết tin tức mới nào.</p>
                    </div>
                }
            </div>
        </div>
    </section>
</div>

